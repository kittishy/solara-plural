// Environment variables — copy to .env.local and fill in values
// NEVER commit .env.local to git

DATABASE_URL=libsql://your-database.turso.io
DATABASE_AUTH_TOKEN=your-turso-auth-token

NEXTAUTH_SECRET=your-very-long-random-secret-min-32-chars
INTEGRATIONS_TOKEN_SECRET=your-separate-long-random-secret-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# Password reset email via SMTP (free with any email provider).
# SMTP_HOST and SMTP_PORT depend on your provider — see below.
# SMTP_USER is your email address, SMTP_PASS is your app password.
# SMTP_FROM is optional (defaults to SMTP_USER).
#
# Gmail:   SMTP_HOST=smtp.gmail.com   SMTP_PORT=587
#   → myaccount.google.com → Security → App passwords
#
# Outlook: SMTP_HOST=smtp-mail.outlook.com  SMTP_PORT=587
#   → account.microsoft.com → Security → App passwords
#
# Yahoo:   SMTP_HOST=smtp.mail.yahoo.com  SMTP_PORT=587
#   → login.yahoo.com → Account security → App passwords
#
# iCloud:  SMTP_HOST=smtp.mail.me.com  SMTP_PORT=587
#   → appleid.apple.com → Sign-In and Security → App-specific passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Solara Plural <your-email@gmail.com>"

# Native Web Push notifications. Generate with: npx web-push generate-vapid-keys --json
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=your-public-vapid-key
WEB_PUSH_VAPID_PRIVATE_KEY=your-private-vapid-key
WEB_PUSH_VAPID_SUBJECT=mailto:you@example.com
