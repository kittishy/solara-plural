<!DOCTYPE html>
<html lang="en" class="var(--font-nunito)">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= h.call(defined?(page_title) && page_title ? "#{page_title} - Solara Plural" : "Solara Plural") %></title>
  <link rel="manifest" href="/manifest.json">
  <style>
    /* Solara core tokens — same CSS custom properties as the React app.
       When loaded inside the full app shell these are overridden by
       Tailwind/globals.css. When rendered standalone (Ruby SSR) they
       provide a usable baseline. */
    :root {
      --font-nunito: 'Nunito', system-ui, -apple-system, sans-serif;
      --theme-bg: #0c0a14;
      --theme-bg-rgb: 12 10 20;
      --theme-surface: #16131f;
      --theme-surface-rgb: 22 19 31;
      --theme-surface-alt: #1e1a2a;
      --theme-surface-alt-rgb: 30 26 42;
      --theme-border: #2a2438;
      --theme-border-rgb: 42 36 56;
      --theme-border-strong: #3d3552;
      --theme-border-strong-rgb: 61 53 82;
      --theme-text: #eeeaf6;
      --theme-text-rgb: 238 234 246;
      --theme-muted: #9e95b0;
      --theme-muted-rgb: 158 149 176;
      --theme-primary: #a78bfa;
      --theme-primary-rgb: 167 139 250;
      --theme-front: #f9a8d4;
      --theme-front-rgb: 249 168 212;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: var(--font-nunito);
      background: var(--theme-bg);
      color: var(--theme-text);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }
    a { color: var(--theme-primary); text-decoration: none; }
    a:hover { text-decoration: underline; }
    .container { max-width: 56rem; margin: 0 auto; padding: 1.25rem 1rem; }
    .card {
      background: var(--theme-surface);
      border: 1px solid var(--theme-border);
      padding: 1rem 1.25rem;
      margin-bottom: 0.75rem;
    }
    .text-muted { color: var(--theme-muted); }
    .text-primary { color: var(--theme-primary); }
    .text-sm { font-size: 0.875rem; }
    .text-xs { font-size: 0.75rem; }
    .font-black { font-weight: 900; }
    .font-bold { font-weight: 700; }
    .uppercase { text-transform: uppercase; }
    .tracking-wide { letter-spacing: 0.05em; }
    .mt-1 { margin-top: 0.25rem; }
    .mt-2 { margin-top: 0.5rem; }
    .mb-3 { margin-bottom: 0.75rem; }
    .space-y-4 > * + * { margin-top: 1rem; }
    .space-y-2 > * + * { margin-top: 0.5rem; }
    .flex { display: flex; }
    .items-center { align-items: center; }
    .gap-2 { gap: 0.5rem; }
    .gap-3 { gap: 0.75rem; }
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); border: 0; }
    /* Responsive */
    @media (min-width: 768px) {
      .container { padding: 2rem; }
    }
  </style>
</head>
<body>
  <main class="container">
    <%= content %>
  </main>
  <%# Minimal JS: only theme restoration from localStorage %>
  <script>
    (function(){
      try {
        var raw = localStorage.getItem('solara.customTheme');
        if (!raw) return;
        var c = JSON.parse(raw);
        var s = document.documentElement.style;
        if (c.bg) s.setProperty('--theme-bg', c.bg);
        if (c.surface) s.setProperty('--theme-surface', c.surface);
        if (c.primary) s.setProperty('--theme-primary', c.primary);
        if (c.text) s.setProperty('--theme-text', c.text);
        if (c.border) s.setProperty('--theme-border', c.border);
      } catch(_){}
    })();
  </script>
</body>
</html>
