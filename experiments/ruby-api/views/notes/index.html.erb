<%# Server-rendered notes list — Ruby SSR %>

<section class="space-y-4">
  <div class="flex items-center gap-2 mb-3">
    <span class="text-primary text-xs font-black" aria-hidden="true">&#9670;</span>
    <span class="text-xs font-black uppercase tracking-wide text-muted">Notes</span>
    <span style="flex:1;height:1px;background:var(--theme-border-strong)" aria-hidden="true"></span>
  </div>

  <h1 style="font-size:1.75rem;font-weight:900;letter-spacing:-0.02em">
    Your Notes
  </h1>
  <p class="text-muted text-sm">
    <%= notes.length %> <%= notes.length == 1 ? 'note' : 'notes' %>
  </p>

  <% if notes.empty? %>
    <div class="card" style="padding:2.5rem;text-align:center;border-left:3px solid var(--theme-border-strong)">
      <p class="text-muted">No notes yet. Write your first note to get started.</p>
    </div>
  <% else %>
    <div class="space-y-2">
      <% notes.each do |note| %>
        <div class="card" style="border-left:3px solid var(--theme-primary)">
          <p style="font-weight:900;font-size:0.875rem;line-height:1.3;
                    white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
            <%= h.call(note[:title] || 'Untitled note') %>
          </p>
          <p class="text-sm text-muted" style="margin-top:4px;
             display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">
            <%= h.call(note[:content]) %>
          </p>
          <% if note[:category] %>
            <span style="display:inline-block;margin-top:6px;font-size:0.625rem;font-weight:700;
                         padding:2px 6px;background:rgba(167,139,250,0.1);color:var(--theme-primary);
                         text-transform:uppercase;letter-spacing:0.05em">
              <%= h.call(note[:category]) %>
            </span>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
