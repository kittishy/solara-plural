{
  "framework": "nextjs",
  "functions": {
    "api/ruby/*.rb": {
      "runtime": "@vercel/ruby@2.3.2",
      "includeFiles": "api/ruby/_lib/**"
    },
    "api/ruby/members/[id].rb": {
      "runtime": "@vercel/ruby@2.3.2",
      "includeFiles": "api/ruby/_lib/**"
    },
    "api/ruby/notes/[id].rb": {
      "runtime": "@vercel/ruby@2.3.2",
      "includeFiles": "api/ruby/_lib/**"
    },
    "api/ruby/journal/[id].rb": {
      "runtime": "@vercel/ruby@2.3.2",
      "includeFiles": "api/ruby/_lib/**"
    },
    "api/ruby/pages/*.rb": {
      "runtime": "@vercel/ruby@2.3.2",
      "includeFiles": "api/ruby/_lib/**,api/ruby/views/**"
    }
  }
}
