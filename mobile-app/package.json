{
  "name": "solara-plural-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "description": "Official open source Android app for Solara Plural.",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src app.config.ts --ext .ts,.tsx",
    "doctor": "npx expo-doctor@latest",
    "export:android": "expo export --platform android",
    "build:android:dev": "eas build --platform android --profile development",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "update:development": "eas update --channel development --platform android --environment development",
    "update:preview": "eas update --channel preview --platform android --environment preview",
    "update:production": "eas update --channel production --platform android --environment production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/native": "^7.1.33",
    "expo": "~55.0.24",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.34",
    "expo-font": "~55.0.7",
    "expo-linking": "~55.0.15",
    "expo-router": "~55.0.14",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.22",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "@types/react": "~19.2.2",
    "eslint": "^8.57.1",
    "eslint-config-expo": "^55.0.0",
    "typescript": "~5.9.2"
  },
  "private": false,
  "license": "MIT",
  "overrides": {
    "postcss": "^8.5.10"
  }
}
